# Tunge, rå media-mapper — hostes separat senere (video-runde), ikke i Git/GitHub
# (rå videofiler/foto-originaler er opptil 1,3 GB; GitHub tillater maks 100 MB/fil)
# Unntak: de små, optimaliserte thumbnail-/galleri-bildene nettsiden faktisk
# bruker (~20 MB totalt) holdes med, se negasjonene under.
Videoer/*
!Videoer/Thumbnails_Nettside/
!Videoer/Podcast_Thumbnail/
# Lett 720p-loop (2 MB) + stillbilde til forsiden. Original-showreelen (27 MB)
# publiseres ikke lenger — den kostet unødvendig mye trafikk på Netlify.
!Videoer/Showreel_hero.mp4
!Videoer/Showreel_poster.jpg
!Videoer/Prosjekter/
Videoer/Prosjekter/*
!Videoer/Prosjekter/Tiktok/

Foto/*
!Foto/Thumbnails_Nettside/

# Systemfiler
.DS_Store
.claude/

# Arbeidsfiler som ikke brukes av nettsiden — skal ikke publiseres
# (de var offentlig tilgjengelige og kunne brukes til å tømme Netlify-kvoten;
# CV-bildet skal heller ikke ligge åpent). Filene ligger fortsatt lokalt.
Phoenix_forestilling.png
Tiktok_0*.png
Bjørnar_Grimstad_CV.pdf.jpg
grim-preview.html
skrift-farge-utforsking.html
TEKSTINNHOLD.txt
.claude/
